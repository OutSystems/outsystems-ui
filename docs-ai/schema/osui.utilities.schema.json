{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/OutSystems/outsystems-ui/docs-ai/schema/osui.utilities.schema.json",
	"title": "OutSystems UI utility classes",
	"description": "Every utility class of the compiled stylesheet (src/scss/05-useful), grouped by family, with the declarations of its plain rule, its variants (rules under an ancestor, pseudo-class or compound), the custom properties it reads and its place in the naming grammar. Generated by scripts/generate-ai-docs.mjs.",
	"type": "object",
	"required": ["version", "grammar", "families"],
	"properties": {
		"$schema": { "type": "string" },
		"version": { "type": "string", "const": "1" },
		"source": { "type": "string" },
		"grammar": {
			"type": "object",
			"required": ["pattern", "heads", "sides", "steps", "shades", "hues"],
			"properties": {
				"pattern": { "type": "string" },
				"heads": { "type": "array", "items": { "type": "string" } },
				"sides": { "type": "array", "items": { "type": "string" } },
				"steps": { "type": "array", "items": { "type": "string" } },
				"shades": { "type": "array", "items": { "type": "string" } },
				"hues": { "type": "array", "items": { "type": "string" } }
			}
		},
		"families": { "type": "array", "items": { "$ref": "#/$defs/family" } }
	},
	"$defs": {
		"family": {
			"type": "object",
			"required": ["name", "title", "file", "classes"],
			"properties": {
				"name": { "type": "string" },
				"title": { "type": "string" },
				"file": { "type": "string" },
				"classes": { "type": "array", "items": { "$ref": "#/$defs/class" } }
			}
		},
		"class": {
			"type": "object",
			"required": ["name", "conformant", "template", "declarations", "variants", "tokens"],
			"properties": {
				"name": { "type": "string" },
				"conformant": {
					"type": "boolean",
					"description": "true when the name follows <property>[-<side>][-<value>]"
				},
				"template": {
					"type": "string",
					"description": "the name with its variable segments as placeholders, e.g. margin-{side}-{step}"
				},
				"declarations": { "type": "array", "items": { "$ref": "#/$defs/declaration" } },
				"variants": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["context", "declarations"],
						"properties": {
							"context": {
								"type": "string",
								"description": "the ancestor, pseudo-class or compound the rule applies in, e.g. .phone or :hover"
							},
							"declarations": { "type": "array", "items": { "$ref": "#/$defs/declaration" } }
						}
					}
				},
				"tokens": { "type": "array", "items": { "type": "string", "pattern": "^--" } }
			}
		},
		"declaration": {
			"type": "object",
			"required": ["prop", "value", "important"],
			"properties": {
				"prop": { "type": "string" },
				"value": { "type": "string" },
				"important": { "type": "boolean" }
			}
		}
	}
}
