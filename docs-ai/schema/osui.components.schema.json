{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/OutSystems/outsystems-ui/docs-ai/schema/osui.components.schema.json",
	"title": "OutSystems UI component manifest",
	"description": "Machine-readable contract of every OutSystems UI pattern: lifecycle, public API signatures, typed configuration props with defaults and allowed values, events, CSS classes, CSS-API knobs and markup skeleton. Generated by scripts/ai-docs/generate-ai-docs.mjs.",
	"type": "object",
	"required": ["version", "components"],
	"properties": {
		"$schema": { "type": "string" },
		"version": { "type": "string", "const": "1" },
		"source": { "type": "string" },
		"components": {
			"type": "object",
			"additionalProperties": { "$ref": "#/$defs/component" }
		}
	},
	"$defs": {
		"component": {
			"type": "object",
			"required": [
				"name",
				"kind",
				"lifecycle",
				"api",
				"props",
				"events",
				"cssClasses",
				"cssApi",
				"markup",
				"files"
			],
			"properties": {
				"name": { "type": "string" },
				"kind": { "type": "string", "enum": ["pattern"] },
				"providers": { "type": "array", "items": { "type": "string" } },
				"lifecycle": { "type": "string" },
				"api": { "type": "array", "items": { "$ref": "#/$defs/apiFunction" } },
				"props": { "type": "object", "additionalProperties": { "$ref": "#/$defs/prop" } },
				"events": { "type": "array", "items": { "type": "string" } },
				"cssClasses": { "type": "object", "additionalProperties": { "type": "string" } },
				"cssApi": { "type": "array", "items": { "type": "string", "pattern": "^--osui-" } },
				"markup": { "type": "string" },
				"usage": {
					"type": "object",
					"description": "The canonical call shape: a configs example carrying every documented default, and the Create / Initialize calls.",
					"required": ["configs", "create", "initialize"],
					"properties": {
						"configs": { "type": "object" },
						"create": { "type": "string" },
						"initialize": { "type": "string" }
					}
				},
				"schema": {
					"type": "string",
					"description": "path of the JSON Schema of the parsed configs string, relative to docs-ai/"
				},
				"docs": {
					"type": "array",
					"items": { "type": "string", "format": "uri" },
					"description": "public ODC documentation pages of the pattern(s) this runtime implements"
				},
				"story": { "type": ["string", "null"] },
				"scss": { "type": "array", "items": { "type": "string" } },
				"files": { "type": "array", "items": { "type": "string" } }
			}
		},
		"apiFunction": {
			"type": "object",
			"required": ["name", "params", "returns"],
			"properties": {
				"name": { "type": "string" },
				"params": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["name", "type"],
						"properties": { "name": { "type": "string" }, "type": { "type": "string" } }
					}
				},
				"returns": { "type": "string" },
				"description": { "type": "string" }
			}
		},
		"prop": {
			"type": "object",
			"required": ["type"],
			"properties": {
				"type": { "type": "string", "minLength": 1 },
				"default": {},
				"allowed": { "type": "array", "items": { "type": ["string", "number"] } },
				"description": { "type": "string" }
			}
		}
	}
}
