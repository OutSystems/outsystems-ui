min-release-age=7
# OutSystems platform widgets (Storybook) come from the internal Azure Artifacts feed.
# Auth lives in the developer's ~/.npmrc (per-user). Only the @outsystems scope is redirected;
# everything else still resolves from the default public registry.
@outsystems:registry=https://pkgs.dev.azure.com/OutSystemsRD/_packaging/ArtifactRepository/npm/registry/
