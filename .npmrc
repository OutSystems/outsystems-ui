# Supply-chain policy: a package published in the last 7 days cannot be installed,
# so a compromised release has a cooling-off window before it can reach us.
min-release-age=7

# Exemption for the first-party design tokens. This repo consumes them within days
# of publication (the whole SCSS layer is generated from them), and the window would
# otherwise fail the build with ETARGET for a week after every tokens release.
# Only this package is exempt — its own dependencies still obey the window above.
# Requires npm >= 11.17; older npm warns "Unknown project config" and IGNORES this
# line, which makes the install fail. The volta pin in package.json is >= 11.18.
min-release-age-exclude[]=outsystems-design-tokens
