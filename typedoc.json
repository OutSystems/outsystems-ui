{
    "entryPoints": [
        "./src/scripts/OSFramework/OSUI/*.ts",
        "./src/scripts/OutSystems/OSUI/*.ts",
        "./src/scripts/Providers/OSUI//*.ts"
    ],
    "entryPointStrategy": "expand",
    "name": "OutSystems UI",
    "plugin": [
        "typedoc-umlclass",
        "typedoc-plugin-merge-modules",
        "./scripts/typedoc-theme/typedoc-theme.mjs"
    ],
    "customCss": "./scripts/typedoc-theme/typedoc-theme.css",
    "favicon": "./.storybook/favicon/favicon.ico",
    "includeVersion": true,
    "hideGenerator": true,
    "out": "./docs",
    "sort": [
        "source-order"
    ],
    "blockTags": [
        "@alpha",
        "@beta",
        "@defaultValue",
        "@deprecated",
        "@example",
        "@experimental",
        "@internal",
        "@override",
        "@param",
        "@privateRemarks",
        "@public",
        "@remarks",
        "@returns",
        "@sealed",
        "@see",
        "@throws",
        "@virtual"
    ],
    "umlClassDiagram": {
        "type": "detailed",
        "location": "local",
        "format": "svg",
        "backgroundColor": "#ced4da",
        "boxBackgroundColor": "#fff",
        "boxBorderColor": "#272b30",
        "arrowColor": "#272b30"
    },
    "validation": {
        "notExported": false,
        "invalidLink": true,
        "notDocumented": false
    }
}
